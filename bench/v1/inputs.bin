A simple Lua module for validating and repairing UTF-8 sequences.

## Installation

This module consists of one C file, `checkutf8.c`, and a C header,
`checkutf8-impl.h`. It could be built manually with a C compiler, or through
luarocks.

lua-checkutf8 requires Lua 5.3 or later, and is only tested with Lua 5.4 and Lua
5.5.

## API

### Validate

```
valid, errorOffset = checkutf8.validate(str)
```

Check for illegal UTF-8 sequences in string `str`. When encountering an invalid
sequence, the function returns `false` and its one-based start position indexed
by bytes; `true` is returned otherwise.

Embedded zeros are allowed in `str`.

### Repair

```
utf8seq = checkutf8.repair(str, [replacement]);
```

Replace each byte of illegal UTF-8 sequences in string `str` with string
`replacement` to generate a valid UTF-8 sequence. `replacement` defaults to
the Unicode replacement character (`U+FFFD`) encoded with UTF-8, i.e.,
`\xef\xbf\xbd`.

It's the caller's responsibility to ensure `replacement` is a valid UTF-8
sequence. Embedded zeros are allowed in both `str` and `replacement`.

Since this function performs replacement for each byte of the illegal sequences
instead of their maximal subparts, it isn't compliant with WHATWG Encoding
Standard, but the Unicode Standard doesn't require such behavior.

## Performance

See [benchmark.md](./benchmark.md) for details.

## Copyright and License

This project is written by `Yao Zi <me@ziyao.cc>`, and released under Mozilla
Public License version 2.0. Refer to `LICENSE` for details.
// SPDX-License-Identifier: MPL-2.0
/*
 * checkutf8 - Module for validating and repairing UTF-8 sequences.
 * Copyright (C) 2026 Yao Zi <me@ziyao.cc>
 */

#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#include <lua.h>
#include <lauxlib.h>

#define UTF8_VALIDATE utf8_validate_fast
#include "checkutf8-impl.h"

#undef UTF8_VALIDATE
#define BOUNDARY_CHECK
#define UTF8_VALIDATE utf8_validate_checked
#include "checkutf8-impl.h"

static size_t
utf8_validate(const char *str, size_t len)
{
	size_t err = 0;

	if (len > 4) {
		err = utf8_validate_fast(str, len - 4);
		str += err;
		len -= err;
	}

	return err + utf8_validate_checked(str, len);
}

static int
checkutf8_validate(lua_State *l)
{
	luaL_checkstring(l, 1);

	size_t len;
	const char *s = lua_tolstring(l, 1, &len);

	size_t err = utf8_validate(s, len);

	if (err == len) {
		lua_pushboolean(l, 1);
		return 1;
	}

	lua_pushboolean(l, 0);
	lua_pushinteger(l, (lua_Integer)err + 1);

	return 2;
}

static int
checkutf8_repair(lua_State *l)
{
	luaL_checkstring(l, 1);

	size_t len;
	const char *s = lua_tolstring(l, 1, &len);

	size_t replacementLen;
	const char *replacement = luaL_optlstring(l, 2, "\xef\xbf\xbd",
						  &replacementLen);

	size_t err = utf8_validate(s, len);
	if (err == len) {
		lua_settop(l, 1);
		return 1;
	}

	luaL_Buffer buff;
	luaL_buffinit(l, &buff);

	luaL_addlstring(&buff, s, err);
	luaL_addlstring(&buff, replacement, replacementLen);

	size_t start = err + 1;
	for (err = utf8_validate(s + start, len - start);
	     start + err < len;
	     err = utf8_validate(s + start, len - start)) {
		luaL_addlstring(&buff, s + start, err);
		luaL_addlstring(&buff, replacement, replacementLen);
		start += err + 1;
	}

	luaL_addlstring(&buff, s + start, len - start);

	luaL_pushresult(&buff);

	return 1;
}

static const luaL_Reg checkutf8_funcs[] = {
	{ "validate", checkutf8_validate },
	{ "repair", checkutf8_repair },
	{ NULL, NULL },
};

int
luaopen_checkutf8(lua_State *l)
{
	luaL_newlib(l, checkutf8_funcs);

	return 1;
}
// SPDX-License-Identifier: MPL-2.0
/*
 * checkutf8 - Module for validating and repairing UTF-8
 * Copyright (C) 2026 Yao Zi <me@ziyao.cc>
 */

/*
 * Some futher optimizations
 * - Add a fast path to process likely ASCII stuff in batch, utilizing the full
 *   machine register (4/8 bytes).
 */

// Trailing bytes are in range [0x80, 0xbf], or [0b1000, 0b1011], i.e. their
// most significant two bits must be 0b10.
#define valid_trailer(c)	(((c) & 0xc0) == 0x80)

static size_t
UTF8_VALIDATE(const char *str, size_t len)
{
	const uint8_t *p = (const uint8_t *)str;
	size_t i = 0;

	while (i < len) {
		if (p[i] <= 0x7f) {
			/* [00, 7f] */
			i++;
		} else if (p[i] >= 0xc2 && p[i] <= 0xdf) {
			/* [c2 - df] [80 - bf] */
#ifdef BOUNDARY_CHECK
			if (len - i < 2)
				return i;
#endif

			if (!valid_trailer(p[i + 1]))
				return i;

			i += 2;
		} else if (p[i] >= 0xe0 && p[i] <= 0xef) {
			/*
			 * [e0]     [a0, bf] [80, bf]
			 * [e1, ec] [80, bf] [80, bf]
			 * [ed]     [80, 9f] [80, bf]
			 * [ee, ef] [80, bf] [80, bf]
			 */
#ifdef BOUNDARY_CHECK
			if (len - i < 3)
				return i;
#endif

			if (!valid_trailer(p[i + 1]) ||
			    !valid_trailer(p[i + 2]))
				return i;

			// For sequences starting with 0xe0 and 0xed
			if ((p[i] == 0xe0 && p[i + 1] < 0xa0) ||
			    (p[i] == 0xed && p[i + 1] > 0x9f))
				return i;

			i += 3;
		} else if (p[i] >= 0xf0 && p[i] <= 0xf4) {
			/*
			 * [f0]     [90, bf] [80, bf] [80, bf]
			 * [f1, f3] [80, bf] [80, bf] [80, bf]
			 * [f4]     [80, 8f] [80, bf] [80, bf]
			 */
#ifdef BOUNDARY_CHECK
			if (len - i < 4)
				return i;
#endif

			if (!valid_trailer(p[i + 1]) ||
			    !valid_trailer(p[i + 2]) ||
			    !valid_trailer(p[i + 3]))
				return i;

			// For sequences starting with 0xf0 and 0xf4
			if ((p[i] == 0xf0 && p[i + 1] < 0x90) ||
			    (p[i] == 0xf4 && p[i + 1] > 0x8f))
				return i;

			i += 4;
		} else {
			return i;
		}
	}

	return i;
}

#undef valid_trailer
local checkutf8			= require "checkutf8";

local nIterations = math.tointeger(os.getenv("ITERATIONS") or 128);

local function
doBench(file)
	local s = io.open(file, "r"):read("a");
	local validate = checkutf8.validate;

	print(("%s: Validation result: %q"):format(file, validate(s)));

	for i = 1, 8 do
		validate(s);
	end

	local t1 = os.clock();

	for i = 1, nIterations do
		validate(s);
	end

	local t2 = os.clock();

	local size = #s * nIterations / 1024 / 1024;
	print(("%s: Validated %.2f MiB data in %.2fs, %.2f MiB/s"):
	      format(file, size, t2 - t1, size / (t2 - t1)));
end

for _, f in ipairs(arg) do
	doBench(f);
end
# lua-checkutf8

A simple Lua module for validating and repairing UTF-8 sequences.

## Installation

This module consists of one C file, `checkutf8.c`, and a C header,
`checkutf8-impl.h`. It could be built manually with a C compiler, or through
luarocks.

lua-checkutf8 requires Lua 5.3 or later, and is only tested with Lua 5.4 and Lua
5.5.

## API

### Validate

```
valid, errorOffset = checkutf8.validate(str)
```

Check for illegal UTF-8 sequences in string `str`. When encountering an invalid
sequence, the function returns `false` and its one-based start position indexed
by bytes; `true` is returned otherwise.

Embedded zeros are allowed in `str`.

### Repair

```
utf8seq = checkutf8.repair(str, [replacement]);
```

Replace each byte of illegal UTF-8 sequences in string `str` with string
`replacement` to generate a valid UTF-8 sequence. `replacement` defaults to
the Unicode replacement character (`U+FFFD`) encoded with UTF-8, i.e.,
`\xef\xbf\xbd`.

It's the caller's responsibility to ensure `replacement` is a valid UTF-8
sequence. Embedded zeros are allowed in both `str` and `replacement`.

Since this function performs replacement for each byte of the illegal sequences
instead of their maximal subparts, it isn't compliant with WHATWG Encoding
Standard, but the Unicode Standard doesn't require such behavior.

## Performance

See [benchmark.md](./benchmark.md) for details.

## Copyright and License

This project is written by `Yao Zi <me@ziyao.cc>`, and released under Mozilla
Public License version 2.0. Refer to `LICENSE` for details.
// SPDX-License-Identifier: MPL-2.0
/*
 * checkutf8 - Module for validating and repairing UTF-8 sequences.
 * Copyright (C) 2026 Yao Zi <me@ziyao.cc>
 */

#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#include <lua.h>
#include <lauxlib.h>

#define UTF8_VALIDATE utf8_validate_fast
#include "checkutf8-impl.h"

#undef UTF8_VALIDATE
#define BOUNDARY_CHECK
#define UTF8_VALIDATE utf8_validate_checked
#include "checkutf8-impl.h"

static size_t
utf8_validate(const char *str, size_t len)
{
	size_t err = 0;

	if (len > 4) {
		err = utf8_validate_fast(str, len - 4);
		str += err;
		len -= err;
	}

	return err + utf8_validate_checked(str, len);
}

static int
checkutf8_validate(lua_State *l)
{
	luaL_checkstring(l, 1);

	size_t len;
	const char *s = lua_tolstring(l, 1, &len);

	size_t err = utf8_validate(s, len);

	if (err == len) {
		lua_pushboolean(l, 1);
		return 1;
	}

	lua_pushboolean(l, 0);
	lua_pushinteger(l, (lua_Integer)err + 1);

	return 2;
}

static int
checkutf8_repair(lua_State *l)
{
	luaL_checkstring(l, 1);

	size_t len;
	const char *s = lua_tolstring(l, 1, &len);

	size_t replacementLen;
	const char *replacement = luaL_optlstring(l, 2, "\xef\xbf\xbd",
						  &replacementLen);

	size_t err = utf8_validate(s, len);
	if (err == len) {
		lua_settop(l, 1);
		return 1;
	}

	luaL_Buffer buff;
	luaL_buffinit(l, &buff);

	luaL_addlstring(&buff, s, err);
	luaL_addlstring(&buff, replacement, replacementLen);

	size_t start = err + 1;
	for (err = utf8_validate(s + start, len - start);
	     start + err < len;
	     err = utf8_validate(s + start, len - start)) {
		luaL_addlstring(&buff, s + start, err);
		luaL_addlstring(&buff, replacement, replacementLen);
		start += err + 1;
	}

	luaL_addlstring(&buff, s + start, len - start);

	luaL_pushresult(&buff);

	return 1;
}

static const luaL_Reg checkutf8_funcs[] = {
	{ "validate", checkutf8_validate },
	{ "repair", checkutf8_repair },
	{ NULL, NULL },
};

int
luaopen_checkutf8(lua_State *l)
{
	luaL_newlib(l, checkutf8_funcs);

	return 1;
}
// SPDX-License-Identifier: MPL-2.0
/*
 * checkutf8 - Module for validating and repairing UTF-8
 * Copyright (C) 2026 Yao Zi <me@ziyao.cc>
 */

/*
 * Some futher optimizations
 * - Add a fast path to process likely ASCII stuff in batch, utilizing the full
 *   machine register (4/8 bytes).
 */

// Trailing bytes are in range [0x80, 0xbf], or [0b1000, 0b1011], i.e. their
// most significant two bits must be 0b10.
#define valid_trailer(c)	(((c) & 0xc0) == 0x80)

static size_t
UTF8_VALIDATE(const char *str, size_t len)
{
	const uint8_t *p = (const uint8_t *)str;
	size_t i = 0;

	while (i < len) {
		if (p[i] <= 0x7f) {
			/* [00, 7f] */
			i++;
		} else if (p[i] >= 0xc2 && p[i] <= 0xdf) {
			/* [c2 - df] [80 - bf] */
#ifdef BOUNDARY_CHECK
			if (len - i < 2)
				return i;
#endif

			if (!valid_trailer(p[i + 1]))
				return i;

			i += 2;
		} else if (p[i] >= 0xe0 && p[i] <= 0xef) {
			/*
			 * [e0]     [a0, bf] [80, bf]
			 * [e1, ec] [80, bf] [80, bf]
			 * [ed]     [80, 9f] [80, bf]
			 * [ee, ef] [80, bf] [80, bf]
			 */
#ifdef BOUNDARY_CHECK
			if (len - i < 3)
				return i;
#endif

			if (!valid_trailer(p[i + 1]) ||
			    !valid_trailer(p[i + 2]))
				return i;

			// For sequences starting with 0xe0 and 0xed
			if ((p[i] == 0xe0 && p[i + 1] < 0xa0) ||
			    (p[i] == 0xed && p[i + 1] > 0x9f))
				return i;

			i += 3;
		} else if (p[i] >= 0xf0 && p[i] <= 0xf4) {
			/*
			 * [f0]     [90, bf] [80, bf] [80, bf]
			 * [f1, f3] [80, bf] [80, bf] [80, bf]
			 * [f4]     [80, 8f] [80, bf] [80, bf]
			 */
#ifdef BOUNDARY_CHECK
			if (len - i < 4)
				return i;
#endif

			if (!valid_trailer(p[i + 1]) ||
			    !valid_trailer(p[i + 2]) ||
			    !valid_trailer(p[i + 3]))
				return i;

			// For sequences starting with 0xf0 and 0xf4
			if ((p[i] == 0xf0 && p[i + 1] < 0x90) ||
			    (p[i] == 0xf4 && p[i + 1] > 0x8f))
				return i;

			i += 4;
		} else {
			return i;
		}
	}

	return i;
}

#undef valid_trailer
local checkutf8			= require "checkutf8";

local nIterations = math.tointeger(os.getenv("ITERATIONS") or 128);

local function
doBench(file)
	local s = io.open(file, "r"):read("a");
	local validate = checkutf8.validate;

	print(("%s: Validation result: %q"):format(file, validate(s)));

	for i = 1, 8 do
		validate(s);
	end

	local t1 = os.clock();

	for i = 1, nIterations do
		validate(s);
	end

	local t2 = os.clock();

	local size = #s * nIterations / 1024 / 1024;
	print(("%s: Validated %.2f MiB data in %.2fs, %.2f MiB/s"):
	      format(file, size, t2 - t1, size / (t2 - t1)));
end

for _, f in ipairs(arg) do
	doBench(f);
